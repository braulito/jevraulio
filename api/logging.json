{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "uvicorn": {
      "()": "uvicorn.logging.DefaultFormatter",
      "fmt": "%(levelprefix)s %(message)s",
      "use_colors": true
    },
    "acceso": {
      "()": "uvicorn.logging.AccessFormatter",
      "fmt": "%(levelprefix)s %(client_addr)s - \"%(request_line)s\" %(status_code)s",
      "use_colors": true
    },
    "general": {
      "()": "uvicorn.logging.DefaultFormatter",
      "fmt": "%(levelprefix)s %(asctime)s - %(filename)s - %(lineno)d - %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S",
      "use_colors": true
    }
  },
  "handlers": {
    "uvicorn": {
      "class": "logging.StreamHandler",
      "formatter": "uvicorn",
      "stream": "ext://sys.stderr"
    },
    "acceso": {
      "class": "logging.StreamHandler",
      "formatter": "acceso",
      "stream": "ext://sys.stdout"
    },
    "consola": {
      "class": "logging.StreamHandler",
      "formatter": "general",
      "stream": "ext://sys.stderr"
    }
  },
  "root": {
    "level": "INFO",
    "handlers": ["consola"]
  },
  "loggers": {
    "uvicorn": {"level": "INFO", "handlers": ["uvicorn"], "propagate": false},
    "uvicorn.error": {"level": "INFO", "handlers": [], "propagate": true},
    "uvicorn.error.billing": {"level": "INFO", "handlers": ["consola"], "propagate": false},
    "uvicorn.access": {"level": "INFO", "handlers": ["acceso"], "propagate": false},
    "httpx": {"level": "WARNING", "handlers": [], "propagate": true},
    "httpcore": {"level": "WARNING", "handlers": [], "propagate": true},
    "mcp": {"level": "WARNING", "handlers": [], "propagate": true}
  }
}
